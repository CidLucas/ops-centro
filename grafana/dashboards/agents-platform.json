    {
      "type": "timeseries",
      "title": "Erro por tool (%)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "expr": "100 * sum by (tool) (rate(agents_platform_tool_calls_total{environment=~\"$environment\", status=\"error\"}[$__rate_interval])) / clamp_min(sum by (tool) (rate(agents_platform_tool_calls_total{environment=~\"$environment\"}[$__rate_interval])), 1e-9)",
          "refId": "A",
          "legendFormat": "{{tool}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": {},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
