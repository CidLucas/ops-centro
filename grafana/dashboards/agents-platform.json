          "expr": "histogram_quantile(0.95, sum by (le, tool) (rate(agents_platform_tool_call_duration_seconds_bucket{environment=~\"$environment\"}[$__rate_interval])))",
          "refId": "B",
          "legendFormat": "p95 {{tool}}"
