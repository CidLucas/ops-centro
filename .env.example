# --- Ambiente -----------------------------------------------------------------
# dev | staging | prod (vocabulário canônico em ops_centro/conventions.py)
ENVIRONMENT=dev

# --- OTLP / Grafana Cloud (RNF06: nunca commitar valores reais) -----------------
# Endpoint OTLP do stack no Grafana Cloud (ex: https://otlp-gateway-<region>.grafana.net/otlp)
OTEL_EXPORTER_OTLP_ENDPOINT=
# Headers de auth URL-encoded, ex: Authorization=Basic%20<base64(instance_id:token)>
OTEL_EXPORTER_OTLP_HEADERS=

# --- Receiver de alertas --------------------------------------------------------
# Token compartilhado com o contact point 'webhook' do Grafana (header X-Alert-Token)
ALERT_WEBHOOK_TOKEN=
RECEIVER_PORT=8080

# --- Grafana Cloud: LEITURA (validação da Fase 1, issue #6) ---------------------
# Token separado do OTLP, com metrics:read/logs:read/traces:read. Os user IDs de cada
# datasource NÃO são o mesmo do gateway OTLP — ver docs/validacao-fase1.md §1.
GRAFANA_READ_TOKEN=
# Token glsa_ (service account): basta a URL do stack — as queries vão pelo proxy.
GRAFANA_STACK_URL=
# Token glc_ (Access Policy): acesso direto, exige URL + user id de cada datasource.
GRAFANA_PROM_URL=
GRAFANA_PROM_USER=
GRAFANA_LOKI_URL=
GRAFANA_LOKI_USER=
GRAFANA_TEMPO_URL=
GRAFANA_TEMPO_USER=

# --- Turso (logs de longa retenção, RF05) ---------------------------------------
# libsql://<db>-<org>.turso.io (vazio = writer de logs vira no-op). Ver docs/turso-logs.md
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Batch do writer (opcionais; defaults 50 registros / 2s)
TURSO_LOG_BATCH_SIZE=
TURSO_LOG_FLUSH_INTERVAL=

# --- Retenção dos logs no Turso (issue #9) --------------------------------------
# Janela por nível. Vazio = defaults: ERROR/CRITICAL 90d, WARNING 30d, INFO 14d,
# DEBUG 7d. Ver docs/turso-retencao.md
TURSO_LOG_RETENTION_DAYS=
# Janela dos níveis fora da lista acima (default 14)
TURSO_LOG_RETENTION_FALLBACK_DAYS=
# Teto de storage usado no relatório do job (default 9 GiB = free tier)
TURSO_DB_SIZE_LIMIT_BYTES=

# --- Grafana: ESCRITA de dashboards as-code (issue #10) -------------------------
# Token com `dashboards:write` — o GRAFANA_READ_TOKEN acima não serve para publicar.
# Usa o mesmo GRAFANA_STACK_URL.
GRAFANA_API_TOKEN=

# --- Grafana: alertas as-code (issue #12) ---------------------------------------
# URL pública do receiver que o contact point vai chamar (ex: https://ops.exemplo.com/alerts/grafana).
# Usa o mesmo GRAFANA_API_TOKEN acima; ver docs/alertas.md
RECEIVER_WEBHOOK_URL=
# uids dos datasources do stack. Vazio = defaults de um stack do Grafana Cloud
# (grafanacloud-prom / grafanacloud-usage). O de uso é o das métricas de billing.
GRAFANA_PROM_DS_UID=
GRAFANA_USAGE_DS_UID=

# --- Enriquecimento de alertas (issue #14) ---------------------------------------
# Deadline da consulta ao Turso, em segundos (default 2). Estourar não segura o alerta:
# ele segue sem contexto. Ver docs/alertas.md §4
ALERT_ENRICHMENT_TIMEOUT=
# uid do datasource do Tempo, para o link do trace na mensagem (default grafanacloud-traces).
# O link em si precisa de GRAFANA_STACK_URL preenchido.
GRAFANA_TEMPO_DS_UID=

# --- Deploy na EC2 do Hermes (issue #13, docs/deploy.md) -------------------------
# Só valem no .env da EC2 (deploy/docker-compose.yml), não em dev.
# Imagem publicada pelo CD; fixe uma tag sha-<commit> para congelar a versão
RECEIVER_IMAGE=
# Interface:porta em que o container publica (default 127.0.0.1:8080 — nunca 0.0.0.0)
RECEIVER_BIND=
# Domínio público e e-mail do ACME, exigidos pelo Caddy do profile `proxy`
RECEIVER_DOMAIN=
ACME_EMAIL=

# --- Hermes / Telegram (fase 3) -------------------------------------------------
# URL do Hermes na EC2 que repassa notificações ao Telegram
HERMES_WEBHOOK_URL=
